<Application x:Class="Tally.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tally.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Colors (swapped for LightTheme.xaml at startup / when toggling the theme) -->
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
                <!-- Look of the controls -->
                <ResourceDictionary Source="Themes/Styles.xaml"/>
                <!-- UI text (swapped for English.xaml at startup / when toggling the language) -->
                <ResourceDictionary Source="Languages/German.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <c:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <c:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
            <c:MoneyConverter x:Key="Money"/>
            <c:QuantityConverter x:Key="Qty"/>
            <c:CategoryLabelConverter x:Key="CategoryLabel"/>
            <c:Fixed2Converter x:Key="Fixed2"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme. Deliberately NOT pure white: the surfaces are a shade down from
         #FFFFFF so a bright room does not turn the window into a lamp. -->
    <SolidColorBrush x:Key="BgBrush" Color="#E6E8EC"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F1F3F6"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#E2E5EA"/>
    <SolidColorBrush x:Key="LineBrush" Color="#D2D6DE"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1A1D23"/>
    <SolidColorBrush x:Key="DimBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#7C3AED"/>
    <!-- Surface behind a selection or a total. Deliberately not a pale wash - against
         white it has to carry enough colour to read as "selected" at a glance. -->
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DFD5FB"/>
    <!-- White, because the light accent is a deep violet - dark text on it would be unreadable. -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#D98E04"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#0F000000"/>
</ResourceDictionary>

<Window x:Class="Tally.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Tally.Views"
        Title="{DynamicResource S_AppTitle}"
        Style="{StaticResource AppWindow}"
        Width="1280" Height="820" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- Entry in the party list: whole row clickable, selection highlighted in teal -->
        <Style x:Key="PartyItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="9" BorderThickness="1" Padding="12,9,6,9"
                                BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Entry in the drink field's suggestion list (not focusable, so typing isn't interrupted) -->
        <Style x:Key="SuggestItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Margin="3,1" Padding="10,7" CornerRadius="5" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================================ Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- 0 title + theme switch -->
                    <RowDefinition Height="Auto"/>   <!-- 1 new party -->
                    <RowDefinition Height="Auto"/>   <!-- 2 list heading -->
                    <RowDefinition Height="*"/>      <!-- 3 party list -->
                    <RowDefinition Height="Auto"/>   <!-- 4 manage articles -->
                    <RowDefinition Height="Auto"/>   <!-- 5 save status -->
                </Grid.RowDefinitions>

                <!-- Title -->
                <Grid Grid.Row="0" Margin="18,18,18,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource S_BrandLine1}" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="{DynamicResource S_BrandLine2}" FontSize="12" FontWeight="SemiBold" Margin="0,1,0,0"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource IconButton}" VerticalAlignment="Center"
                            FontSize="11" FontWeight="Bold"
                            Content="{Binding LanguageToggleGlyph}" Command="{Binding ToggleLanguageCommand}"
                            ToolTip="{DynamicResource S_ToggleLanguageTooltip}"/>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Center"
                            Content="{Binding ThemeToggleGlyph}" Command="{Binding ToggleThemeCommand}"
                            ToolTip="{DynamicResource S_ToggleThemeTooltip}"/>
                </Grid>

                <!-- New party -->
                <StackPanel Grid.Row="1" Margin="18,0,18,16">
                    <TextBlock Text="{DynamicResource S_NewParty}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NewPartyBox" Margin="0,0,0,8" v:Ui.Placeholder="{DynamicResource S_NamePlaceholder}"
                             Text="{Binding NewPartyName, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding CreatePartyCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="{DynamicResource S_DateEmptyToday}" Style="{StaticResource FieldLabel}" Margin="0,2,0,5"/>
                    <v:DateField SelectedDate="{Binding NewPartyDate, Mode=TwoWay}" Margin="0,0,0,10"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource S_AddParty}"
                            Command="{Binding CreatePartyCommand}"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="{DynamicResource S_Parties}" Style="{StaticResource FieldLabel}" Margin="18,4,18,6"/>

                <!-- Party list -->
                <Grid Grid.Row="3">
                    <ListBox x:Name="PartyList" Style="{StaticResource PlainListBox}"
                             ItemContainerStyle="{StaticResource PartyItemStyle}"
                             Margin="8,0,8,0" Padding="0,0,0,6"
                             ItemsSource="{Binding SortedParties}"
                             SelectedItem="{Binding SelectedParty, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Margin="0,2,0,0" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource DimBrush}">
                                            <Run Text="{Binding DateText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding ItemCountText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button x:Name="DeleteButton" Grid.Column="1" VerticalAlignment="Center"
                                            Style="{StaticResource DangerGhostButton}" Content="✕"
                                            ToolTip="{DynamicResource S_DeletePartyTooltip}" Visibility="Hidden"
                                            Command="{Binding DataContext.DeletePartyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="DeleteButton" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{DynamicResource S_NoPartiesYet}" HorizontalAlignment="Center" VerticalAlignment="Top"
                               Margin="0,18,0,0" IsHitTestVisible="False" Foreground="{DynamicResource DimBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SortedParties.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Manage articles -->
                <Button Grid.Row="4" Margin="18,8,18,14" Content="{DynamicResource S_ManageArticles}"
                        Command="{Binding OpenArticlesCommand}"/>

                <!-- Save status and backups -->
                <Border Grid.Row="5" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}"
                        Padding="18,14,18,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S_Save}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" VerticalAlignment="Top" Margin="0,4,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StorageStatusKind}" Value="busy">
                                                <Setter Property="Fill" Value="{DynamicResource WarnBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StorageStatusKind}" Value="error">
                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                                       Text="{Binding StorageStatusText}"/>
                        </Grid>

                        <TextBlock Margin="17,5,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource DimBrush}"
                                   Text="{Binding DataFolderDisplay}" ToolTip="{Binding DataFolderPath}"/>

                        <Button Style="{StaticResource CompactButton}" Content="{DynamicResource S_RetrySave}" Margin="0,10,0,0"
                                Command="{Binding RetrySaveCommand}"
                                Visibility="{Binding ShowRetrySave, Converter={StaticResource BoolToVis}}"/>

                        <UniformGrid Columns="2" Margin="0,12,0,0">
                            <Button Style="{StaticResource CompactButton}" Content="{DynamicResource S_OpenFolder}" Margin="0,0,3,6"
                                    Command="{Binding OpenDataFolderCommand}"
                                    ToolTip="{DynamicResource S_OpenFolderTooltip}"/>
                            <Button Style="{StaticResource CompactButton}" Content="{DynamicResource S_ChangeFolder}" Margin="3,0,0,6"
                                    Command="{Binding ChangeDataFolderCommand}"
                                    ToolTip="{DynamicResource S_ChangeFolderTooltip}"/>
                            <Button Style="{StaticResource CompactButton}" Content="{DynamicResource S_BackupNow}" Margin="0,0,3,0"
                                    Command="{Binding BackupNowCommand}"/>
                            <Button Style="{StaticResource CompactButton}" Content="{DynamicResource S_BackupsEllipsis}" Margin="3,0,0,0"
                                    Command="{Binding ShowBackupsCommand}"
                                    ToolTip="{DynamicResource S_BackupsTooltip}"/>
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource LinkButton}" Content="{DynamicResource S_Export}"
                                    Command="{Binding ExportCommand}"
                                    ToolTip="{DynamicResource S_ExportTooltip}"/>
                            <TextBlock Text="·" Margin="8,0" Foreground="{DynamicResource DimBrush}"/>
                            <Button Style="{StaticResource LinkButton}" Content="{DynamicResource S_Import}"
                                    Command="{Binding ImportCommand}"
                                    ToolTip="{DynamicResource S_ImportTooltip}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================================================================ Main area -->
        <Grid Grid.Column="1">

            <!-- No party selected -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasSelectedParty, Converter={StaticResource InvBoolToVis}}">
                <TextBlock Text="{DynamicResource S_NoPartySelected}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource DimBrush}"
                           Text="{DynamicResource S_NoPartySelectedHint}"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasSelectedParty, Converter={StaticResource BoolToVis}}">
                <StackPanel MaxWidth="980" Margin="36,28,36,40">

                    <!-- ===== Header: name, date, print -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="PartyNameBox" Style="{StaticResource HeadingTextBox}"
                                 VerticalAlignment="Center" MaxLength="120"
                                 Text="{Binding SelectedParty.Name, Mode=OneWay}"
                                 ToolTip="{DynamicResource S_RenameTooltip}"
                                 LostKeyboardFocus="PartyName_LostKeyboardFocus"
                                 PreviewKeyDown="PartyName_PreviewKeyDown"/>

                        <v:DateField Grid.Column="1" Width="170" Margin="16,0,0,0" VerticalAlignment="Center"
                                     SelectedDate="{Binding SelectedParty.Date, Mode=TwoWay}"/>

                        <!-- Prints whatever the open tab shows. Content/ToolTip live in the style,
                             because a local value would always beat the trigger below. -->
                        <Button Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                Command="{Binding PrintCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="{DynamicResource S_Print}"/>
                                    <Setter Property="ToolTip" Value="{DynamicResource S_PrintTooltip}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGuestsTab}" Value="True">
                                            <Setter Property="Content" Value="{DynamicResource S_PrintGuests}"/>
                                            <Setter Property="ToolTip" Value="{DynamicResource S_PrintGuestsTooltip}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- ===== Tabs: drinks | guests -->
                    <Border CornerRadius="10" BorderThickness="1" Margin="0,0,0,18" Padding="3"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource LineBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource TabButton}"
                                    v:Ui.IsActive="{Binding IsDrinksTab}"
                                    Content="{DynamicResource S_TabDrinks}"
                                    Command="{Binding SetTabCommand}" CommandParameter="drinks"/>
                            <Button Style="{StaticResource TabButton}" Margin="3,0,0,0"
                                    v:Ui.IsActive="{Binding IsGuestsTab}"
                                    Content="{DynamicResource S_TabGuests}"
                                    Command="{Binding SetTabCommand}" CommandParameter="guests"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== Form: add / edit item -->
                    <Border Padding="20,18,20,20" CornerRadius="12" BorderThickness="1" Margin="0,0,0,18"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                            Visibility="{Binding IsDrinksTab, Converter={StaticResource BoolToVis}}"
                            PreviewKeyDown="Form_PreviewKeyDown">
                        <StackPanel>
                            <Grid Margin="0,0,0,12" MinHeight="30">
                                <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource S_AddDrink}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource S_EditItem}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="10,4"
                                        Content="{DynamicResource S_CancelEdit}" Command="{Binding CancelEditCommand}"
                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Drink (with suggestions from the article list) -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                                    <TextBlock Text="{DynamicResource S_Drink}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="NameBox" v:Ui.Placeholder="{DynamicResource S_DrinkPlaceholder}"
                                             v:Ui.IsInvalid="{Binding NameInvalid}"
                                             Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="NameBox_TextChanged"
                                             PreviewKeyDown="NameBox_PreviewKeyDown"
                                             LostKeyboardFocus="NameBox_LostKeyboardFocus"/>
                                    <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=NameBox}"
                                           Placement="Bottom" StaysOpen="True" AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border x:Name="SuggestBorder" Margin="0,4,0,0" Padding="0,3" CornerRadius="8"
                                                BorderThickness="1" MaxHeight="320"
                                                TextElement.Foreground="{DynamicResource TextBrush}"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource LineBrush}">
                                            <ListBox x:Name="SuggestList" Style="{StaticResource PlainListBox}"
                                                     Focusable="False"
                                                     ItemContainerStyle="{StaticResource SuggestItemStyle}"
                                                     PreviewMouseLeftButtonDown="SuggestList_PreviewMouseLeftButtonDown">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Margin="14,0,0,0" FontSize="11"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource DimBrush}"
                                                                       Text="{Binding Category}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </StackPanel>

                                <!-- Category -->
                                <StackPanel Grid.Row="0" Grid.Column="4">
                                    <TextBlock Text="{DynamicResource S_Category}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CategoryBox" ItemsSource="{Binding FormCategoryOptions}"
                                              SelectedItem="{Binding FormCategory}"/>
                                </StackPanel>

                                <!-- Store -->
                                <StackPanel Grid.Row="0" Grid.Column="6">
                                    <TextBlock Text="{DynamicResource S_StoreOptional}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox v:Ui.Placeholder="{DynamicResource S_StorePlaceholder}"
                                             Text="{Binding FormStore, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <!-- Quantity -->
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource S_Quantity}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="QuantityBox" v:Ui.IsInvalid="{Binding QuantityInvalid}"
                                             Text="{Binding FormQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <!-- Unit price / total price: one automatically calculates the other -->
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource S_UnitPriceEuro}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox v:Ui.Placeholder="0,00"
                                             Text="{Binding FormUnitPrice, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="4">
                                    <TextBlock Text="{DynamicResource S_TotalPriceEuro}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox v:Ui.Placeholder="0,00"
                                             Text="{Binding FormTotalPrice, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <!-- Save / Add -->
                                <Button Grid.Row="2" Grid.Column="6" Style="{StaticResource PrimaryButton}"
                                        VerticalAlignment="Bottom"
                                        Content="{Binding SubmitButtonText}" Command="{Binding SubmitItemCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== Items -->
                    <Border CornerRadius="12" BorderThickness="1" Margin="0,0,0,18"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                            Visibility="{Binding IsDrinksTab, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <!-- Column headers (same column widths as the rows) -->
                            <Grid Margin="16,13,16,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource S_Drink}" Style="{StaticResource FieldLabel}" Margin="0"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource S_Category}" Style="{StaticResource FieldLabel}" Margin="0"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource S_Quantity}" Style="{StaticResource FieldLabel}" Margin="0" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="{DynamicResource S_UnitPriceColumn}" Style="{StaticResource FieldLabel}" Margin="0" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="{DynamicResource S_TotalPriceColumn}" Style="{StaticResource FieldLabel}" Margin="0" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="{DynamicResource S_StoreColumn}" Style="{StaticResource FieldLabel}" Margin="18,0,0,0"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding SelectedParty.Items}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" Padding="16,10" BorderThickness="0,1,0,0"
                                                Background="Transparent" BorderBrush="{DynamicResource LineBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="1.3*"/>
                                                    <ColumnDefinition Width="72"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,10,0" Foreground="{DynamicResource DimBrush}"
                                                           Text="{Binding Category, Converter={StaticResource CategoryLabel}}"/>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           Text="{Binding Quantity, Converter={StaticResource Qty}}"/>
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           Text="{Binding UnitPrice, Converter={StaticResource Money}}"/>
                                                <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding TotalPrice, Converter={StaticResource Money}}"/>
                                                <TextBlock Grid.Column="5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Margin="18,0,0,0" Foreground="{DynamicResource DimBrush}"
                                                           Text="{Binding Store}" ToolTip="{Binding Store}"/>

                                                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource AccentGhostButton}" Content="✎" ToolTip="{DynamicResource S_EditTooltip}"
                                                            Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource DangerGhostButton}" Content="✕" ToolTip="{DynamicResource S_DeleteTooltip}"
                                                            Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- empty -->
                            <TextBlock Text="{DynamicResource S_NoItemsYet}"
                                       HorizontalAlignment="Center" Margin="0,22,0,26"
                                       Foreground="{DynamicResource DimBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedParty.Items.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ===== Summary -->
                    <Grid Visibility="{Binding IsDrinksTab, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Totals per category -->
                        <ItemsControl ItemsSource="{Binding SelectedParty.CategoryTotals}" VerticalAlignment="Top"
                                      Focusable="False" Margin="0,0,20,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,8,8" Padding="14,7" CornerRadius="17" BorderThickness="1"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource LineBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Category}" Margin="0,0,9,0"
                                                       Foreground="{DynamicResource DimBrush}"/>
                                            <TextBlock Text="{Binding Sum, Converter={StaticResource Money}}"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Grand total -->
                        <Border Grid.Column="1" Padding="26,14,26,14" CornerRadius="12" BorderThickness="1"
                                MinWidth="230" VerticalAlignment="Top"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBrush}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S_GrandTotal}" HorizontalAlignment="Right" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{DynamicResource DimBrush}"/>
                                <TextBlock HorizontalAlignment="Right" FontSize="28" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding SelectedParty.TotalPrice, Converter={StaticResource Money}}"/>
                                <TextBlock HorizontalAlignment="Right" FontSize="12"
                                           Foreground="{DynamicResource DimBrush}"
                                           Text="{Binding SelectedParty.ItemCountText}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ===== Guests tab: who owes what, and what is left over -->
                    <StackPanel Visibility="{Binding IsGuestsTab, Converter={StaticResource BoolToVis}}">

                        <!-- Add a guest -->
                        <Border Padding="20,18,20,20" CornerRadius="12" BorderThickness="1" Margin="0,0,0,18"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S_AddGuest}" FontSize="14" FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource S_GuestName}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="NewGuestBox"
                                                 v:Ui.Placeholder="{DynamicResource S_GuestNamePlaceholder}"
                                                 Text="{Binding NewGuestName, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding AddGuestCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource S_OwesEuro}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox v:Ui.Placeholder="0,00" HorizontalContentAlignment="Right"
                                                 Text="{Binding NewGuestOwes, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding AddGuestCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </StackPanel>

                                    <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"
                                            Content="{DynamicResource S_AddGuestButton}" Command="{Binding AddGuestCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Guest table -->
                        <Border CornerRadius="12" BorderThickness="1"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}">
                            <StackPanel>
                                <!-- Column headers (same column widths as the rows) -->
                                <Grid Margin="16,13,16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="72"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource S_GuestName}" Style="{StaticResource FieldLabel}" Margin="0"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource S_OwesColumn}" Style="{StaticResource FieldLabel}" Margin="0" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{DynamicResource S_PaidColumn}" Style="{StaticResource FieldLabel}" Margin="0" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{DynamicResource S_OpenColumn}" Style="{StaticResource FieldLabel}" Margin="0" HorizontalAlignment="Right"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding SelectedParty.Guests}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" Padding="16,8" BorderThickness="0,1,0,0"
                                                    Background="Transparent" BorderBrush="{DynamicResource LineBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="72"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Applied on Enter / when leaving the field, Esc discards -->
                                                    <TextBox Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"
                                                             MaxLength="80"
                                                             Text="{Binding Name, Mode=OneWay}"
                                                             LostKeyboardFocus="GuestName_LostKeyboardFocus"
                                                             PreviewKeyDown="GuestName_PreviewKeyDown"/>

                                                    <TextBox Grid.Column="1" Margin="0,0,8,0" Tag="owes" MaxLength="12"
                                                             VerticalAlignment="Center" HorizontalContentAlignment="Right"
                                                             Text="{Binding Owes, Converter={StaticResource Fixed2}, Mode=OneWay}"
                                                             LostKeyboardFocus="GuestMoney_LostKeyboardFocus"
                                                             PreviewKeyDown="GuestMoney_PreviewKeyDown"/>

                                                    <TextBox Grid.Column="2" Margin="0,0,8,0" Tag="paid" MaxLength="12"
                                                             VerticalAlignment="Center" HorizontalContentAlignment="Right"
                                                             Text="{Binding Paid, Converter={StaticResource Fixed2}, Mode=OneWay}"
                                                             LostKeyboardFocus="GuestMoney_LostKeyboardFocus"
                                                             PreviewKeyDown="GuestMoney_PreviewKeyDown"/>

                                                    <TextBlock x:Name="OpenText" Grid.Column="3" VerticalAlignment="Center"
                                                               HorizontalAlignment="Right" FontWeight="SemiBold"
                                                               Text="{Binding Open, Converter={StaticResource Money}}"/>

                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center">
                                                        <Button Style="{StaticResource AccentGhostButton}" Content="✓"
                                                                ToolTip="{DynamicResource S_SettleGuestTooltip}"
                                                                Command="{Binding DataContext.SettleGuestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Style="{StaticResource DangerGhostButton}" Content="✕"
                                                                ToolTip="{DynamicResource S_DeleteGuestTooltip}"
                                                                Command="{Binding DataContext.DeleteGuestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                                </Trigger>
                                                <!-- Fully paid: the open amount fades back -->
                                                <DataTrigger Binding="{Binding IsSettled}" Value="True">
                                                    <Setter TargetName="OpenText" Property="Foreground" Value="{DynamicResource DimBrush}"/>
                                                    <Setter TargetName="OpenText" Property="FontWeight" Value="Normal"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- No guests yet -->
                                <TextBlock Text="{DynamicResource S_NoGuestsYet}"
                                           HorizontalAlignment="Center" Margin="0,22,0,26"
                                           Foreground="{DynamicResource DimBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedParty.Guests.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- ===== Result: collected minus spent -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <WrapPanel VerticalAlignment="Top" Margin="0,0,20,0">
                                <Border Margin="0,0,8,8" Padding="14,7" CornerRadius="17" BorderThickness="1"
                                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource S_SpentOnDrinks}" Margin="0,0,9,0"
                                                   Foreground="{DynamicResource DimBrush}"/>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding SelectedParty.TotalPrice, Converter={StaticResource Money}}"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,8,8" Padding="14,7" CornerRadius="17" BorderThickness="1"
                                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource S_Collected}" Margin="0,0,9,0"
                                                   Foreground="{DynamicResource DimBrush}"/>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding SelectedParty.GuestsPaid, Converter={StaticResource Money}}"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,8,8" Padding="14,7" CornerRadius="17" BorderThickness="1"
                                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource S_StillOpen}" Margin="0,0,9,0"
                                                   Foreground="{DynamicResource DimBrush}"/>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding SelectedParty.GuestsOpen, Converter={StaticResource Money}}"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <Border Grid.Column="1" Padding="26,14,26,14" CornerRadius="12" BorderThickness="1"
                                    MinWidth="250" VerticalAlignment="Top">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedParty.IsProfitNegative}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S_Result}" HorizontalAlignment="Right" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{DynamicResource DimBrush}"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="28" FontWeight="Bold"
                                               Text="{Binding SelectedParty.Profit, Converter={StaticResource Money}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedParty.IsProfitNegative}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock HorizontalAlignment="Right" FontSize="12"
                                               Foreground="{DynamicResource DimBrush}"
                                               Text="{DynamicResource S_ResultFormula}"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="11" Margin="0,3,0,0"
                                               Foreground="{DynamicResource DimBrush}"
                                               Text="{DynamicResource S_NotCoveredYet}"
                                               Visibility="{Binding SelectedParty.IsProfitNegative, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

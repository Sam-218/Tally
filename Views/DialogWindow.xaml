<Window x:Class="Tally.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Width="480" SizeToContent="Height" MinHeight="150"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">
    <Grid Margin="24,22,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource DimBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButton" Visibility="Collapsed" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="SecondaryButton" Visibility="Collapsed" Margin="0,0,8,0" Click="Secondary_Click"/>
            <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Primary_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="Tally.Views.BackupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S_BackupsTitle}" Style="{StaticResource AppWindow}"
        Width="640" Height="520" MinWidth="520" MinHeight="380"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="BackupItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Margin="4,2" Padding="10,9" CornerRadius="8"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource S_RestoreBackups}" FontSize="18" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,6,0,14" Foreground="{DynamicResource DimBrush}"
                   Text="{DynamicResource S_RestoreBackupsHint}"/>

        <Border Grid.Row="2" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"
                Background="{DynamicResource SurfaceBrush}">
            <Grid>
                <ListBox x:Name="BackupList" Style="{StaticResource PlainListBox}" Padding="0,4"
                         ItemContainerStyle="{StaticResource BackupItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="BackupList_SelectionChanged"
                         MouseDoubleClick="BackupList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Reason}" Foreground="{DynamicResource DimBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{DynamicResource DimBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="{DynamicResource S_NoBackupsYet}" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource DimBrush}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{DynamicResource S_OpenFolder}" HorizontalAlignment="Left" Click="OpenFolder_Click"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource S_Close}" Margin="0,0,8,0" Click="Close_Click"/>
                <Button x:Name="RestoreButton" Content="{DynamicResource S_Restore}" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="Restore_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

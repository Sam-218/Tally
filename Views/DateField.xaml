<UserControl x:Class="Tally.Views.DateField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid>
        <!-- Input field: type "14.06.2025" or open the calendar via ▾ -->
        <Border x:Name="Box" CornerRadius="7" BorderThickness="1" Background="{DynamicResource BgBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="True">
                <Button x:Name="OpenButton" DockPanel.Dock="Right" Content="▾"
                        Style="{StaticResource GhostButton}" Padding="10,4" Margin="1"
                        ToolTip="{DynamicResource S_OpenCalendarTooltip}" Click="OpenButton_Click"/>
                <TextBox x:Name="Input" Style="{StaticResource BareTextBox}"
                         VerticalContentAlignment="Center" Padding="6,7,0,7"
                         PreviewKeyDown="Input_PreviewKeyDown" LostKeyboardFocus="Input_LostKeyboardFocus"
                         TextChanged="Input_TextChanged"/>
            </DockPanel>
        </Border>

        <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=Box}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Margin="0,4,0,0" Padding="10" CornerRadius="10" BorderThickness="1"
                    TextElement.Foreground="{DynamicResource TextBrush}"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}">
                <StackPanel Width="224">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="◀" Style="{StaticResource GhostButton}" Padding="10,4"
                                Focusable="False" Click="PrevMonth_Click"/>
                        <TextBlock x:Name="MonthText" Grid.Column="1" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Button Grid.Column="2" Content="▶" Style="{StaticResource GhostButton}" Padding="10,4"
                                Focusable="False" Click="NextMonth_Click"/>
                    </Grid>
                    <UniformGrid Columns="7" Margin="0,0,0,4">
                        <TextBlock Text="{DynamicResource S_Mon}" HorizontalAlignment="Center" Foreground="{DynamicResource DimBrush}" FontSize="11"/>
                        <TextBlock Text="{DynamicResource S_Tue}" HorizontalAlignment="Center" Foreground="{DynamicResource DimBrush}" FontSize="11"/>
                        <TextBlock Text="{DynamicResource S_Wed}" HorizontalAlignment="Center" Foreground="{DynamicResource DimBrush}" FontSize="11"/>
                        <TextBlock Text="{DynamicResource S_Thu}" HorizontalAlignment="Center" Foreground="{DynamicResource DimBrush}" FontSize="11"/>
                        <TextBlock Text="{DynamicResource S_Fri}" HorizontalAlignment="Center" Foreground="{DynamicResource DimBrush}" FontSize="11"/>
                        <TextBlock Text="{DynamicResource S_Sat}" HorizontalAlignment="Center" Foreground="{DynamicResource DimBrush}" FontSize="11"/>
                        <TextBlock Text="{DynamicResource S_Sun}" HorizontalAlignment="Center" Foreground="{DynamicResource DimBrush}" FontSize="11"/>
                    </UniformGrid>
                    <UniformGrid x:Name="DaysGrid" Columns="7" Rows="6"/>
                    <Button Content="{DynamicResource S_Today}" Style="{StaticResource LinkButton}" HorizontalAlignment="Center"
                            Margin="0,8,0,0" Click="Today_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
